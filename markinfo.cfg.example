# Copy to markinfo.cfg in the working directory or ~/.markinfo/markinfo.cfg

[database]
# sqlite (default) or mysql
type = sqlite
path = markinfo.db

[mysql]
host = localhost
port = 3306
user = markinfo
password =
database = markinfo

[ui]
# Size multiplier for high-DPI / scaled displays.
# 1.0 = 100%, 1.5 = 150%, 2.0 = 200%. Allowed range is 1.0 to 2.5.
scale = 1.0
